DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/barberbarbar?schema=public"
JWT_SECRET="ganti-dengan-secret-yang-panjang-dan-acak"

# Aktifkan eksplisit setelah migration tracking dan kunci lokal siap.
GUEST_BOOKING_ENABLED=false
# Buat32byte acak dalam base64 secara privat; jangan commit kunci nyata.
BOOKING_TRACKING_ENCRYPTION_KEY=
GUEST_WEB_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Persiapan email: belum aktif sampai adapter/provider disetujui dan dipasang.
# Jangan menambahkan credential nyata pada file contoh ini.
EMAIL_RESET_FROM="noreply@example.com"
CUSTOMER_PASSWORD_RESET_URL="barberbarbar-customer://reset-password"
